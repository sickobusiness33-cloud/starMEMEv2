# HootRadar — environment / variables de entorno
# Copy to .env (repo root) and adjust. Variables already set in the real environment win over .env.
# Copia a .env (raíz del repo) y ajusta. Las variables ya definidas en el entorno tienen prioridad.
# Numbers, URLs, keys and tokens may be left empty (default / disabled). To use the default of a text or
# choice value (HOST, AI_MODEL, AI_EFFORT_*, NEWS_LANG, DISTRIBUTION_MIN_SEVERITY) delete the line instead.
# Números, URLs, claves y tokens pueden quedar vacíos (por defecto / desactivado). Para usar el valor por
# defecto de un texto u opción (HOST, AI_MODEL, AI_EFFORT_*, NEWS_LANG, DISTRIBUTION_MIN_SEVERITY) borra la línea.

# ─── Server / Servidor ───────────────────────────────────────────────
# HTTP port / Puerto HTTP
PORT=8787
# Bind address (0.0.0.0 = all interfaces) / Dirección de escucha (0.0.0.0 = todas)
HOST=0.0.0.0
# SQLite data directory, relative to the working directory / Carpeta de datos SQLite (relativa al directorio de trabajo)
DATA_DIR=./data
# Public URL used in distributed posts, e.g. https://hootradar.example.com (empty = no link)
# URL pública usada en las publicaciones distribuidas (vacío = sin enlace)
PUBLIC_BASE_URL=
# Built web app folder (default: <repo>/web/dist when it exists) / Carpeta del frontend compilado
WEB_DIST=
# Behind a reverse proxy, so rate limits see the real client IP: the proxy's IPs/CIDRs, comma-separated
# (recommended, e.g. 10.0.0.0/8), or the number of proxy hops in front of the app (e.g. 1; safe only when the app
# cannot be reached without going through them). Empty = no proxy. "true" no longer trusts every hop (clients could
# spoof X-Forwarded-For): it means 1 hop and logs a warning.
# Detrás de un proxy inverso (IP real del cliente): IPs/CIDRs del proxy separadas por comas (recomendado), o el número
# de saltos de proxy (p. ej. 1; solo si la app no es accesible sin pasar por ellos). Vacío = sin proxy.
TRUST_PROXY=
# debug | info | warn | error. Read at process start: set it in the real environment, not in .env
# Se lee al arrancar el proceso: defínela en el entorno real, no en .env
LOG_LEVEL=info

# ─── AI / IA (Claude) ────────────────────────────────────────────────
# Optional. Empty = deterministic rules writer (the header says so)
# Opcional. Vacío = redactor por reglas determinista (la cabecera lo indica)
ANTHROPIC_API_KEY=
# Claude model / Modelo de Claude
AI_MODEL=claude-opus-5-5
# Effort for news articles: low | medium | high / Esfuerzo para noticias
AI_EFFORT_NEWS=low
# Effort for Radar research: low | medium | high / Esfuerzo para investigación Radar
AI_EFFORT_RESEARCH=medium
# Per-request timeout (ms) before falling back to rules / Tiempo máximo por petición (ms) antes de usar reglas
AI_TIMEOUT_MS=45000
# Article language: es | en / Idioma de los artículos
NEWS_LANG=es
# Claude web search in Radar (paid per search; off = free intel providers only): true | false
# Búsqueda web de Claude en Radar (de pago por búsqueda; false = solo proveedores gratuitos)
RADAR_WEB_RESEARCH=true
# Claude calls (web research + brief) that public Radar searches may start per hour, across all visitors;
# beyond it Radar skips web research and writes the brief with the rules engine (results are reused per token)
# Llamadas a Claude (búsqueda web + resumen) que Radar puede iniciar por hora entre todos los visitantes
RADAR_AI_CALLS_PER_HOUR=60

# ─── Scanner / Escáner ───────────────────────────────────────────────
# Comma-separated: solana,ethereum,base,bsc (an unknown name stops startup) / Cadenas a escanear, separadas por comas
CHAINS=solana,ethereum,base,bsc
# New-token discovery interval per chain (ms, min 10000) / Intervalo de descubrimiento por cadena (ms, mín. 10000)
SCAN_INTERVAL_MS=30000
# Market-data refresh interval for tracked tokens (ms, min 10000) / Intervalo de actualización de tokens seguidos (ms, mín. 10000)
REFRESH_INTERVAL_MS=20000
# Only tokens younger than this are tracked (hours) / Solo se siguen tokens más jóvenes que esto (horas)
MAX_TOKEN_AGE_HOURS=24
# Minimum pool liquidity to raise a detection (USD) / Liquidez mínima para generar una detección (USD)
MIN_LIQUIDITY_USD=10000
# Minimum 1h volume to raise a detection (USD) / Volumen mínimo en 1h para generar una detección (USD)
MIN_VOLUME_H1_USD=10000

# ─── Detection / Detección (anomaly score 0-100) ────────────────────
# Defaults calibrated on live data: ~10-15 ALERT/BREAKING articles per hour across 4 chains.
# Valores calibrados con datos reales: ~10-15 artículos ALERT/BREAKING por hora en 4 cadenas.
# Score for WATCH (stored, no article) / Puntuación para WATCH (se guarda, sin artículo)
THRESHOLD_WATCH=22
# Score for ALERT (article) / Puntuación para ALERT (artículo)
THRESHOLD_ALERT=42
# Score for BREAKING (article) / Puntuación para BREAKING (artículo)
THRESHOLD_BREAKING=60
# (thresholds must satisfy WATCH < ALERT <= BREAKING / deben cumplir WATCH < ALERT <= BREAKING)
# BREAKING also needs real size: below either minimum (or with top-10 holders >= 80%, mint or freeze authority
# enabled) a BREAKING score is published as ALERT. Liquidity (USD) / 1h volume (USD)
# BREAKING exige tamaño real: por debajo de cualquiera de estos mínimos (o con top 10 >= 80%, autoridad de
# mint o de congelación activa) una puntuación BREAKING se publica como ALERT. Liquidez (USD) / volumen 1h (USD)
BREAKING_MIN_LIQUIDITY_USD=25000
BREAKING_MIN_VOLUME_H1_USD=75000
# Minutes between articles about the same token unless it escalates / Minutos entre artículos del mismo token salvo escalada
ARTICLE_COOLDOWN_MIN=30
# Global article cap per hour / Límite global de artículos por hora
MAX_ARTICLES_PER_HOUR=30
# Publish articles automatically (true/false; any other word stops startup) / Publicar artículos automáticamente
AUTOPUBLISH=true

# ─── Distribution / Distribución (text only, never trades) ──────────
# Empty channel = posts stay "ready" for copy-paste. X is never posted automatically.
# Canal vacío = las publicaciones quedan "listas" para copiar. X nunca se publica automáticamente.
# Discord webhook URL / URL del webhook de Discord
DISCORD_WEBHOOK_URL=
# Telegram bot token and target chat id / Token del bot de Telegram y chat de destino
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic webhook receiving a compact article JSON (POST) / Webhook genérico que recibe el artículo en JSON (POST)
DISTRIBUTION_WEBHOOK_URL=
# Minimum severity sent automatically: BREAKING | ALERT / Severidad mínima enviada automáticamente
DISTRIBUTION_MIN_SEVERITY=BREAKING

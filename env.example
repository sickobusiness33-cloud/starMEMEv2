# Copia este archivo a .env y rellena los valores para correr el bot en local.
# En Railway, estas mismas variables se configuran en el panel del proyecto
# (Settings > Variables), no en un archivo .env.

# --- Obligatorias -----------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# --- Filtros de calidad (opcionales, se muestran valores por defecto) ------
MIN_MARKET_CAP_USD=30000
MIN_LIQUIDITY_USD=15000
MIN_VOLUME_24H_USD=20000
MIN_TXNS_24H=100
MIN_LIQ_MCAP_RATIO=0.03
MIN_PAIR_AGE_MINUTES=15
MAX_PAIR_AGE_DAYS=5
MAX_DROP_1H_PCT=30

# --- Comportamiento del bot (opcionales) ------------------------------------
MAX_ALERTS_PER_DAY=10
CHECK_INTERVAL_SECONDS=300
AXIOM_REFERRAL_LINK=https://axiom.trade/@sickopump

# --- Seguimiento de resultados ("os lo dije") (opcionales) ------------------
RESULT_CELEBRATE_PCT=50
RESULT_MIN_AGE_HOURS=6
RESULT_MAX_AGE_DAYS=7

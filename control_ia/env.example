# Control IA — ejemplo de configuración. SIN secretos reales.
# Copia a un archivo .env (que está en .gitignore) o define estas variables
# en tu plataforma de despliegue (Railway: Settings > Variables).

# --- Secretos (NUNCA los subas al repositorio) -------------------------------
# Clave Fernet para cifrar credenciales de conectores y proveedores.
# Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si no la defines, en local se genera data/secret.key (0600). Si la pierdes o
# la cambias, las credenciales guardadas dejan de poder descifrarse.
CONTROL_SECRET_KEY=

# API keys opcionales por entorno. También se pueden guardar (cifradas) desde
# Configuración → Proveedores; la guardada en la app tiene prioridad.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Configuración pública -----------------------------------------------------
# 0.0.0.0 para exponerlo detrás de un proxy/HTTPS
CONTROL_HOST=127.0.0.1
# si no se define, usa PORT (Railway lo inyecta)
CONTROL_PORT=8000
# SQLite + clave local. Usa un volumen persistente.
CONTROL_DATA_DIR=data
# true en producción (solo HTTPS)
CONTROL_COOKIE_SECURE=false
CONTROL_SESSION_HOURS=12

# Límites de uso
CONTROL_MAX_CONCURRENT_RUNS=2
CONTROL_RUNS_PER_MINUTE=10
CONTROL_LOGIN_ATTEMPTS_PER_MINUTE=5
CONTROL_PROVIDER_TIMEOUT_SECONDS=120
CONTROL_PROVIDER_MAX_RETRIES=2
CONTROL_MAX_FILE_BYTES=262144

# Proveedores
# proveedor "Demostración local" (no es IA)
CONTROL_ENABLE_DEMO_PROVIDER=true
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
